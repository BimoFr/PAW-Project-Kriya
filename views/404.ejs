<%- include('partials/head', { title }) %>
<%- include('partials/navbar') %>

<main id="konten" class="flex-1 grid place-items-center px-5 py-24">
  <div class="text-center max-w-md">
    <p class="font-mono text-sm text-soga"><%= typeof kode !== 'undefined' ? kode : 404 %></p>
    <h1 class="mt-3 font-display font-semibold tracking-tight text-4xl"><%= typeof judul !== 'undefined' ? judul : 'Halaman tidak ditemukan' %></h1>
    <p class="mt-3 text-muted"><%= typeof pesan !== 'undefined' ? pesan : 'Alamat yang kamu buka tidak tersedia atau sudah dipindahkan.' %></p>
    <a href="/" class="mt-8 inline-flex bg-ink text-paper text-sm font-medium px-6 py-3.5 rounded-lg transition-colors duration-200 hover:bg-soga">Kembali ke beranda</a>
  </div>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
