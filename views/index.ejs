<%- include('partials/head', { title }) %>
<%- include('partials/navbar') %>

<main id="konten">

  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-5 sm:px-8 pt-14 pb-16 sm:pt-20 sm:pb-24">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      <div class="lg:col-span-7">
        <p class="rise text-sm font-medium text-soga mb-5">Batik &amp; tenun Nusantara</p>
        <h1 class="rise rise-2 font-display font-semibold tracking-tight leading-[1.02] text-[2.75rem] sm:text-6xl lg:text-[4.5rem]">
          Kain karya pengrajin, langsung ke tanganmu.
        </h1>
        <p class="rise rise-3 mt-6 max-w-xl text-lg text-muted leading-relaxed">
          Batik tulis, batik cap, dan tenun pilihan dari para pengrajin. Stok tercatat rapi, jadi yang kamu lihat adalah yang benar-benar tersedia.
        </p>
        <div class="rise rise-3 mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href="#produk" class="inline-flex items-center gap-2 bg-ink text-paper font-medium text-sm px-6 py-3.5 rounded-lg transition-colors duration-200 hover:bg-soga">
            Lihat produk
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
          </a>
          <a href="#api" class="navlink text-sm font-medium">Lihat endpoint API</a>
        </div>
      </div>

      <!-- Kartu status (data hidup dari /api/status) -->
      <div class="lg:col-span-5 rise rise-3">
        <div class="bg-ink text-paper rounded-2xl p-6 sm:p-7">
          <div class="flex items-center justify-between gap-4 font-mono text-[13px]">
            <span class="font-medium">GET /api/status</span>
            <span class="flex items-center gap-2 text-[#C9D2E0]">
              <span id="status-dot" class="w-2 h-2 rounded-full bg-[#E0A458] dot-live"></span>
              <span id="status-label">Memuat…</span>
            </span>
          </div>
          <pre id="status-json" class="mt-5 font-mono text-[13px] leading-relaxed text-[#C9D2E0] overflow-x-auto whitespace-pre" aria-live="polite">{
  "status": "…"
}</pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Produk -->
  <section id="produk" class="border-t border-line scroll-mt-16">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-16 sm:py-20">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div>
          <h2 class="font-display font-semibold tracking-tight text-3xl sm:text-4xl">Koleksi minggu ini</h2>
          <p class="mt-2 text-muted">
            Data diambil dari database · <span id="jumlah"><%= produk.length %> produk</span>
          </p>
        </div>

        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter kategori">
          <button type="button" data-filter="semua" aria-pressed="true"
                  class="px-4 py-2 rounded-full border border-ink bg-ink text-paper text-sm font-medium transition-colors duration-200">Semua</button>
          <% kategori.forEach(function (k) { %>
            <button type="button" data-filter="<%= k.toLowerCase() %>" aria-pressed="false"
                    class="px-4 py-2 rounded-full border border-line text-sm font-medium transition-colors duration-200 hover:border-ink"><%= k %></button>
          <% }) %>
        </div>
      </div>

      <% if (!produk.length) { %>
        <p class="mt-10 py-12 text-muted">Belum ada produk. <a href="/kelola" class="text-soga font-medium navlink">Tambah produk pertama</a>.</p>
      <% } %>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <% produk.forEach(function (p) { %>
          <article data-kategori="<%= p.kategori.toLowerCase() %>"
                   class="group flex flex-col bg-white border border-line rounded-xl overflow-hidden transition duration-300 hover:-translate-y-0.5 hover:border-ink/40">
            <div class="overflow-hidden aspect-[4/3]" aria-hidden="true">
              <div class="motif motif-<%= p.motif %> kat-<%= p.kategori.toLowerCase() %> w-full h-full transition-transform duration-500 group-hover:scale-105"></div>
            </div>
            <div class="flex flex-col flex-1 p-5">
              <p class="text-xs font-medium uppercase tracking-wider text-muted"><%= p.kategori %> · <%= p.motif %></p>
              <h3 class="mt-2 font-display font-semibold text-lg leading-snug"><%= p.nama %></h3>
              <p class="mt-2 text-sm text-muted leading-relaxed"><%= p.deskripsi %></p>
              <div class="mt-auto pt-5 flex items-end justify-between gap-3">
                <p class="font-semibold"><%= formatRupiah(p.harga) %></p>
                <p class="text-xs <%= p.stok <= 10 ? 'text-soga font-medium' : 'text-muted' %>">
                  <%= p.stok <= 10 ? 'Stok terbatas · ' + p.stok : 'Stok ' + p.stok %>
                </p>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- API -->
  <section id="api" class="border-t border-line scroll-mt-16">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-16 sm:py-20">
      <h2 class="font-display font-semibold tracking-tight text-3xl sm:text-4xl">Endpoint API</h2>
      <p class="mt-2 text-muted max-w-xl">Endpoint REST API untuk CRUD produk. Setiap request dicatat oleh middleware logger.</p>

      <div class="mt-10 border-t border-line">
        <a href="/api/status" class="group flex items-center justify-between gap-4 py-4 border-b border-line transition-colors hover:text-soga">
          <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-6">
            <code class="font-mono text-sm font-medium"><span class="inline-block w-16 text-soga">GET</span>/api/status</code>
            <span class="text-sm text-muted">Status server, database, dan uptime</span>
          </div>
          <span class="text-lg transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
        <a href="/api/produk" class="group flex items-center justify-between gap-4 py-4 border-b border-line transition-colors hover:text-soga">
          <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-6">
            <code class="font-mono text-sm font-medium"><span class="inline-block w-16 text-soga">GET</span>/api/produk</code>
            <span class="text-sm text-muted">Seluruh produk dari database</span>
          </div>
          <span class="text-lg transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
        <a href="/api/produk/1" class="group flex items-center justify-between gap-4 py-4 border-b border-line transition-colors hover:text-soga">
          <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-6">
            <code class="font-mono text-sm font-medium"><span class="inline-block w-16 text-soga">GET</span>/api/produk/:id</code>
            <span class="text-sm text-muted">Detail satu produk</span>
          </div>
          <span class="text-lg transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
        <div class="flex items-center justify-between gap-4 py-4 border-b border-line">
          <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-6">
            <code class="font-mono text-sm font-medium"><span class="inline-block w-16 text-soga">POST</span>/api/produk</code>
            <span class="text-sm text-muted">Menambahkan produk baru</span>
          </div>
          <span class="hidden sm:inline text-xs text-muted">uji lewat Postman</span>
        </div>
        <div class="flex items-center justify-between gap-4 py-4 border-b border-line">
          <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-6">
            <code class="font-mono text-sm font-medium"><span class="inline-block w-16 text-soga">PUT</span>/api/produk/:id</code>
            <span class="text-sm text-muted">Memperbarui produk berdasarkan ID</span>
          </div>
          <span class="hidden sm:inline text-xs text-muted">uji lewat Postman</span>
        </div>
        <div class="flex items-center justify-between gap-4 py-4 border-b border-line">
          <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-6">
            <code class="font-mono text-sm font-medium"><span class="inline-block w-16 text-soga">DELETE</span>/api/produk/:id</code>
            <span class="text-sm text-muted">Menghapus produk berdasarkan ID</span>
          </div>
          <span class="hidden sm:inline text-xs text-muted">uji lewat Postman</span>
        </div>
      </div>

      <p class="mt-6 text-sm text-muted">
        Log request tersimpan di <code class="font-mono text-[13px] bg-ink/5 px-1.5 py-0.5 rounded">logs/logger.md</code> dan tampil di terminal.
      </p>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
