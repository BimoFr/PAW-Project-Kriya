<header class="sticky top-0 z-40 bg-paper/90 backdrop-blur border-b border-line">
  <nav class="max-w-6xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between" aria-label="Navigasi utama">
    <a href="/" class="flex items-center gap-2.5 font-display font-semibold text-xl tracking-tight" aria-label="<%= appName %> — beranda">
      <span class="grid place-items-center w-7 h-7 rounded-md bg-ink text-paper text-sm font-bold" aria-hidden="true">K</span>
      <%= appName %>
    </a>

    <div class="flex items-center gap-4 sm:gap-7">
      <div class="hidden md:flex items-center gap-7 text-sm font-medium">
        <a href="/#produk" class="navlink">Produk</a>
        <a href="/lacak" class="navlink">Lacak Pesanan</a>

        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
          <a href="/kelola" class="navlink text-soga">Kelola</a>
          <form action="/keluar" method="POST" class="inline">
            <button type="submit" class="navlink text-muted hover:text-ink">Keluar</button>
          </form>
        <% } %>
      </div>

      <% if (typeof isAdmin === 'undefined' || !isAdmin) { %>
        <button type="button" onclick="bukaKeranjang()" aria-label="Buka keranjang belanja"
                class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-line bg-white/70 hover:border-ink transition-colors">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <span id="cart-badge" class="tabular-nums text-xs font-medium bg-ink text-paper px-1.5 py-0.5 rounded">0</span>
        </button>
      <% } %>

      <button id="menu-btn" type="button" class="md:hidden -mr-2 p-2 rounded-lg hover:bg-ink/5 transition-colors"
              aria-expanded="false" aria-controls="menu-mobile" aria-label="Buka menu">
        <svg id="ico-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg id="ico-close" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </nav>

  <div id="menu-mobile" class="hidden md:hidden border-t border-line bg-paper">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-3 flex flex-col text-sm font-medium">
      <a href="/#produk" class="py-3 border-b border-line">Produk</a>
      <a href="/lacak" class="py-3 <%= (typeof isAdmin !== 'undefined' && isAdmin) ? 'border-b border-line' : '' %>">Lacak Pesanan</a>

      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <a href="/kelola" class="py-3 border-b border-line text-soga">Kelola</a>
        <a href="/api/produk" class="py-3 border-b border-line">API produk</a>
        <a href="/api/status" class="py-3 border-b border-line">API status</a>
        <form action="/keluar" method="POST">
          <button type="submit" class="w-full text-left py-3 text-muted hover:text-ink">Keluar</button>
        </form>
      <% } %>
    </div>
  </div>
</header>