<script>
  // ---------- Kelola produk: CRUD lewat /api/produk ----------
  (function () {
    var daftar = document.getElementById('daftar');
    var dlgForm = document.getElementById('dlg-form');
    var dlgHapus = document.getElementById('dlg-hapus');
    var form = document.getElementById('form');
    var errBox = document.getElementById('form-error');
    var toast = document.getElementById('toast');
    var berkas = document.getElementById('f-berkas');
    var pratinjau = document.getElementById('pratinjau');
    var btnHapusGambar = document.getElementById('btn-hapus-gambar');
    var data = [], editId = null, hapusId = null, toastTimer;

    function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function rp(n) { return 'Rp ' + Number(n).toLocaleString('id-ID'); }

    function api(url, opt) {
      return fetch(url, opt).then(function (r) {
        return r.json().catch(function () { return {}; }).then(function (b) {
          if (!r.ok) { var e = new Error(b.error || 'Permintaan gagal'); e.detail = b.detail; throw e; }
          return b;
        });
      });
    }

    function notif(teks) {
      if (!toast) return;
      toast.textContent = teks; toast.classList.remove('hidden');
      clearTimeout(toastTimer); toastTimer = setTimeout(function () { toast.classList.add('hidden'); }, 3000);
    }

    // Memberi tanda ke tab katalog bahwa data produk berubah
    function tandai() {
      try { localStorage.setItem('kriya-produk-berubah', String(Date.now())); } catch (e) {}
    }

    function baris(p) {
      var kat = p.kategori.toLowerCase();
      var thumb = p.gambar
        ? '<img src="/images/produk/' + encodeURIComponent(p.gambar) + '" alt="" class="w-14 h-14 rounded-lg object-cover shrink-0 border border-line">'
        : '<div class="kat-' + esc(kat) + ' w-14 h-14 rounded-lg shrink-0 bg-paper border border-line" aria-hidden="true"></div>';
      return '<div class="fade flex flex-col sm:flex-row sm:items-center gap-4 py-5 border-b border-line">' +
        thumb +
        '<div class="flex-1 min-w-0"><p class="font-display font-semibold leading-snug">' + esc(p.nama) + '</p>' +
        '<p class="text-sm text-muted">' + esc(p.kategori) + ' · stok ' + esc(p.stok) + '</p></div>' +
        '<p class="font-semibold sm:w-32 sm:text-right">' + rp(p.harga) + '</p>' +
        '<div class="flex gap-2">' +
        '<button type="button" data-aksi="ubah" data-id="' + p.id + '" class="px-4 py-2 rounded-lg border border-line text-sm font-medium transition-colors hover:border-ink">Ubah</button>' +
        '<button type="button" data-aksi="hapus" data-id="' + p.id + '" class="px-4 py-2 rounded-lg border border-line text-sm font-medium text-soga transition-colors hover:border-soga">Hapus</button>' +
        '</div></div>';
    }

    function render() {
      daftar.innerHTML = data.length ? data.map(baris).join('') : '<p class="py-12 text-muted">Belum ada produk. Klik “Tambah produk” untuk memulai.</p>';
    }

    function muat() {
      return api('/api/produk').then(function (rows) { data = rows; render(); })
        .catch(function () { daftar.innerHTML = '<p class="py-12 text-muted">Gagal memuat data dari server.</p>'; });
    }

    function tampilError(daftarError) {
      if (!errBox) { alert(daftarError.join('\n')); return; }
      errBox.innerHTML = daftarError.map(function (e) { return '<li>' + esc(e) + '</li>'; }).join('');
      errBox.classList.remove('hidden');
    }

    // ----- AI Auto-Caption Deskripsi Produk (F-06 / US-06) -----
    function generateCaptionAI(btnEl) {
      var targetForm = (btnEl && btnEl.closest && btnEl.closest('form')) || form;
      var btn = btnEl || document.getElementById('btn-generate-caption');
      if (!targetForm || !targetForm.elements) return;

      var f = targetForm.elements;
      var nama = (f.nama ? f.nama.value : '').trim();
      var kategori = (f.kategori ? f.kategori.value : 'Batik').trim();
      var harga = Number(f.harga ? f.harga.value : 0);
      var deskripsiEl = f.deskripsi;

      if (!nama) {
        tampilError(['Isi nama produk terlebih dahulu sebelum menggunakan Generate Caption AI.']);
        if (f.nama) f.nama.focus();
        return;
      }

      if (errBox) errBox.classList.add('hidden');
      var teksAsli = btn ? btn.innerHTML : 'Generate Caption AI';
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Membuat deskripsi...';
      }

      api('/api/generate-caption', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nama: nama, kategori: kategori, harga: harga })
      })
        .then(function (res) {
          if (deskripsiEl) {
            deskripsiEl.value = res.caption || '';
            deskripsiEl.dispatchEvent(new Event('input', { bubbles: true }));
            deskripsiEl.focus();
          }
          notif('Deskripsi produk berhasil dibuat oleh AI');
        })
        .catch(function (err) {
          tampilError([err.message || 'Gagal membuat caption AI.']);
        })
        .then(function () {
          if (btn) {
            btn.disabled = false;
            btn.innerHTML = teksAsli;
          }
        });
    }
    window.generateCaptionAI = generateCaptionAI;

    var btnCaption = document.getElementById('btn-generate-caption');
    if (btnCaption) {
      btnCaption.addEventListener('click', function () { generateCaptionAI(btnCaption); });
    }

    // ----- Pemilih gambar -----
    function setPratinjau(src) {
      pratinjau.innerHTML = src
        ? '<img src="' + src + '" alt="Pratinjau gambar" class="w-full h-full object-cover">'
        : 'Belum ada';
      btnHapusGambar.classList.toggle('hidden', !src);
    }

    function unggah(file) {
      var fd = new FormData();
      fd.append('gambar', file);
      return api('/api/upload', { method: 'POST', body: fd }).then(function (r) { return r.gambar; });
    }

    berkas.addEventListener('change', function () {
      var file = berkas.files[0];
      if (!file) return;
      if (['image/jpeg', 'image/png', 'image/webp'].indexOf(file.type) === -1) {
        tampilError(['Format gambar harus JPG, PNG, atau WebP']); berkas.value = ''; return;
      }
      if (file.size > 2 * 1024 * 1024) {
        tampilError(['Ukuran gambar maksimal 2 MB']); berkas.value = ''; return;
      }
      errBox.classList.add('hidden');
      setPratinjau(URL.createObjectURL(file));
    });

    btnHapusGambar.addEventListener('click', function () {
      berkas.value = ''; form.elements.gambar.value = ''; setPratinjau(null);
    });

    // ----- Form tambah / ubah -----
    function bukaForm(p) {
      editId = p ? p.id : null;
      document.getElementById('form-judul').textContent = p ? 'Ubah produk' : 'Tambah produk';
      form.reset(); errBox.classList.add('hidden');
      if (p) {
        ['nama', 'kategori', 'harga', 'stok', 'deskripsi', 'gambar'].forEach(function (k) {
          if (form.elements[k]) form.elements[k].value = p[k] == null ? '' : p[k];
        });
      }
      setPratinjau(p && p.gambar ? '/images/produk/' + encodeURIComponent(p.gambar) : null);
      dlgForm.showModal();
      form.elements.nama.focus();
    }

    async function simpanStatusPesanan(id) {
      var el = document.getElementById('status-ord-' + id);
      if (!el) return;
      var status = el.value;
      try {
        var res = await fetch('/api/pesanan/' + id + '/status', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: status })
        });
        var data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal memperbarui status');
        notif('Status pesanan diubah menjadi "' + status + '"');
      } catch (err) {
        alert(err.message);
      }
    }
    window.simpanStatusPesanan = simpanStatusPesanan;

    document.getElementById('btn-tambah').addEventListener('click', function () { bukaForm(null); });
    document.getElementById('btn-batal').addEventListener('click', function () { dlgForm.close(); });
    document.getElementById('hapus-batal').addEventListener('click', function () { dlgHapus.close(); });

    // Klik di luar dialog menutupnya
    [dlgForm, dlgHapus].forEach(function (d) {
      d.addEventListener('click', function (e) { if (e.target === d) d.close(); });
    });

    daftar.addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-aksi]');
      if (!btn) return;
      var p = data.find(function (x) { return x.id === Number(btn.dataset.id); });
      if (!p) return;
      if (btn.dataset.aksi === 'ubah') bukaForm(p);
      else { hapusId = p.id; document.getElementById('hapus-nama').textContent = p.nama; dlgHapus.showModal(); }
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var f = form.elements;
      var payload = {
        nama: f.nama.value.trim(),
        kategori: f.kategori.value,
        harga: f.harga.value,
        stok: f.stok.value,
        deskripsi: f.deskripsi.value.trim(),
        gambar: f.gambar.value.trim()
      };
      var simpan = document.getElementById('btn-simpan');
      simpan.disabled = true;

      // Unggah gambar dulu (jika ada file baru), baru simpan data produk
      var siap = berkas.files[0]
        ? unggah(berkas.files[0]).then(function (nama) { payload.gambar = nama; })
        : Promise.resolve();

      siap.then(function () {
        return api(editId ? '/api/produk/' + editId : '/api/produk', {
          method: editId ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      }).then(function () {
        dlgForm.close(); tandai(); notif(editId ? 'Produk berhasil diperbarui' : 'Produk berhasil ditambahkan'); return muat();
      }).catch(function (err) {
        tampilError(err.detail && err.detail.length ? err.detail : [err.message]);
      }).then(function () { simpan.disabled = false; });
    });

    document.getElementById('hapus-ok').addEventListener('click', function () {
      api('/api/produk/' + hapusId, { method: 'DELETE' })
        .then(function () { dlgHapus.close(); tandai(); notif('Produk berhasil dihapus'); return muat(); })
        .catch(function (err) { dlgHapus.close(); notif(err.message); });
    });

    muat();
  })();
</script>