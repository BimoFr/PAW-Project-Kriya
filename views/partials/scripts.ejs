<script>
  // ---------- Menu mobile ----------
  (function () {
    var btn = document.getElementById('menu-btn');
    var menu = document.getElementById('menu-mobile');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      var open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
      document.getElementById('ico-open').classList.toggle('hidden', open);
      document.getElementById('ico-close').classList.toggle('hidden', !open);
    });
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { if (!menu.classList.contains('hidden')) btn.click(); });
    });
  })();

  // ---------- Status server (GET /api/status) ----------
  (function () {
    var out = document.getElementById('status-json');
    var label = document.getElementById('status-label');
    var dot = document.getElementById('status-dot');
    if (!out) return;

    function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;'); }

    function render(obj) {
      var rows = Object.keys(obj).map(function (k, i, arr) {
        var v = obj[k];
        var val = typeof v === 'string'
          ? '<span class="text-[#F0B58E]">"' + esc(v) + '"</span>'
          : '<span class="text-[#F0B58E]">' + esc(v) + '</span>';
        return '  <span class="text-[#9DB0CC]">"' + esc(k) + '"</span>: ' + val + (i < arr.length - 1 ? ',' : '');
      });
      out.innerHTML = '{\n' + rows.join('\n') + '\n}';
    }

    function setOnline(ok) {
      label.textContent = ok ? 'Server berjalan' : 'Tidak terhubung';
      dot.className = 'w-2 h-2 rounded-full ' + (ok ? 'bg-[#E0A458] dot-live' : 'bg-[#C46A5A]');
    }

    function load() {
      fetch('/api/status')
        .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
        .then(function (data) { render(data); setOnline(true); })
        .catch(function () { setOnline(false); out.textContent = '{\n  "error": "Gagal memuat /api/status"\n}'; });
    }

    load();
    setInterval(load, 10000);
  })();

  // ---------- Filter kategori ----------
  (function () {
    var chips = document.querySelectorAll('[data-filter]');
    var cards = document.querySelectorAll('[data-kategori]');
    var jumlah = document.getElementById('jumlah');
    if (!chips.length) return;

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var f = chip.getAttribute('data-filter');
        chips.forEach(function (c) {
          var aktif = c === chip;
          c.setAttribute('aria-pressed', String(aktif));
          c.classList.toggle('bg-ink', aktif);
          c.classList.toggle('text-paper', aktif);
          c.classList.toggle('border-ink', aktif);
        });

        var n = 0;
        cards.forEach(function (card) {
          var tampil = f === 'semua' || card.getAttribute('data-kategori') === f;
          card.classList.remove('fade');
          card.hidden = !tampil;
          if (tampil) { n++; void card.offsetWidth; card.classList.add('fade'); }
        });
        if (jumlah) jumlah.textContent = n + ' produk';
      });
    });
  })();

  // ---------- Keranjang Belanja & Guest Checkout ----------
  var keranjang = JSON.parse(localStorage.getItem('kriya_cart') || '[]');

  function formatIdr(angka) {
    return 'Rp ' + Number(angka).toLocaleString('id-ID');
  }

  function escHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function simpanKeranjang() {
    localStorage.setItem('kriya_cart', JSON.stringify(keranjang));
    renderKeranjang();
  }

  function bukaKeranjang() {
    var successBox = document.getElementById('checkout-success');
    var overlay = document.getElementById('cart-overlay');
    var drawer = document.getElementById('cart-drawer');
    if (successBox) successBox.classList.add('hidden');
    if (overlay) overlay.classList.remove('hidden');
    if (drawer) drawer.classList.remove('hidden');
    renderKeranjang();
  }

  function tutupKeranjang() {
    var overlay = document.getElementById('cart-overlay');
    var drawer = document.getElementById('cart-drawer');
    if (overlay) overlay.classList.add('hidden');
    if (drawer) drawer.classList.add('hidden');
  }

  function tambahDariTombol(btn) {
    var id = Number(btn.dataset.id);
    var nama = btn.dataset.nama;
    var harga = Number(btn.dataset.harga);
    var stok = Number(btn.dataset.stok);
    tambahKeKeranjang(id, nama, harga, stok);
  }

  function tambahKeKeranjang(id, nama, harga, stokMax) {
    if (stokMax <= 0) return;

    var existing = keranjang.find(function (item) { return item.id === id; });
    if (existing) {
      if (existing.qty >= stokMax) {
        alert('Maksimal pembelian sesuai stok tersedia (' + stokMax + ').');
        return;
      }
      existing.qty += 1;
      existing.stokMax = stokMax;
    } else {
      keranjang.push({ id: id, nama: nama, harga: harga, qty: 1, stokMax: stokMax });
    }
    simpanKeranjang();
    bukaKeranjang();
  }

  function ubahQty(id, delta) {
    var idx = keranjang.findIndex(function (item) { return item.id === id; });
    if (idx === -1) return;

    var baru = keranjang[idx].qty + delta;
    if (baru <= 0) {
      keranjang.splice(idx, 1);
    } else if (baru <= keranjang[idx].stokMax) {
      keranjang[idx].qty = baru;
    }
    simpanKeranjang();
  }

  function renderKeranjang() {
    var badge = document.getElementById('cart-badge');
    var container = document.getElementById('cart-items-container');
    var form = document.getElementById('checkout-form');
    var totalEl = document.getElementById('cart-total');

    var totalItem = keranjang.reduce(function (sum, i) { return sum + i.qty; }, 0);
    if (badge) badge.textContent = totalItem;

    if (!container || !form || !totalEl) return;

    if (keranjang.length === 0) {
      container.innerHTML = '<p class="text-sm text-muted py-8 text-center">Keranjang belanjamu masih kosong.</p>';
      form.classList.add('hidden');
      return;
    }

    form.classList.remove('hidden');
    var totalHarga = 0;

    container.innerHTML = keranjang.map(function (item) {
      var subtotal = item.harga * item.qty;
      totalHarga += subtotal;
      return (
        '<div class="bg-white border border-line rounded-lg p-3.5 flex items-center justify-between gap-3">' +
          '<div class="min-w-0">' +
            '<p class="text-sm font-medium truncate">' + escHtml(item.nama) + '</p>' +
            '<p class="text-xs text-muted mt-0.5">' + formatIdr(item.harga) + ' &times; ' + item.qty + '</p>' +
          '</div>' +
          '<div class="flex items-center gap-1.5 shrink-0">' +
            '<button type="button" onclick="ubahQty(' + item.id + ', -1)" class="w-7 h-7 rounded border border-line text-xs hover:border-ink">&minus;</button>' +
            '<span class="w-6 text-center text-xs font-medium tabular-nums">' + item.qty + '</span>' +
            '<button type="button" onclick="ubahQty(' + item.id + ', 1)" class="w-7 h-7 rounded border border-line text-xs hover:border-ink">+</button>' +
          '</div>' +
        '</div>'
      );
    }).join('');

    totalEl.textContent = formatIdr(totalHarga);
  }

  // ---------- Chatbot Asisten Belanja AI (POST /api/chat) ----------
  var riwayatChat = [];

  function toggleChatWidget() {
    var panel = document.getElementById('chat-panel');
    var btn = document.getElementById('chat-toggle-btn');
    if (!panel || !btn) return;
    var terbuka = panel.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(terbuka));
    if (terbuka) {
      var input = document.getElementById('chat-input');
      if (input) input.focus();
    }
  }

  function formatTeksBot(teks) {
    return escHtml(teks)
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\n/g, '<br>');
  }

  function tambahGelembungChat(peran, teks, waFallbackUrl) {
    var box = document.getElementById('chat-messages');
    if (!box) return;

    var div = document.createElement('div');
    if (peran === 'user') {
      div.className = 'ml-auto max-w-[85%] bg-ink text-paper rounded-xl rounded-tr-sm px-3 py-2';
      div.innerHTML = escHtml(teks);
    } else {
      div.className = 'mr-auto max-w-[90%] bg-white border border-line text-ink rounded-xl rounded-tl-sm p-3 space-y-2';
      div.innerHTML = '<div>' + formatTeksBot(teks) + '</div>';
      if (waFallbackUrl) {
        div.innerHTML += '<a href="' + escHtml(waFallbackUrl) + '" target="_blank" rel="noopener noreferrer" class="inline-block text-[11px] font-medium text-soga underline">Lanjutkan ke WhatsApp Pengrajin &rarr;</a>';
      }
    }

    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
  }

  function kirimPertanyaanCepat(teks) {
    var input = document.getElementById('chat-input');
    var form = document.getElementById('chat-form');
    if (!input || !form) return;
    input.value = teks;
    form.dispatchEvent(new Event('submit', { cancelable: true }));
  }

  document.addEventListener('DOMContentLoaded', function () {
    renderKeranjang();

    // Form Checkout
    var form = document.getElementById('checkout-form');
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var errBox = document.getElementById('checkout-error');
        var btn = document.getElementById('btn-submit-checkout');
        errBox.classList.add('hidden');
        btn.disabled = true;
        btn.textContent = 'Memproses...';

        try {
          var formData = new FormData(form);
          var namaVal = String(formData.get('nama_pembeli') || '').trim();
          var waVal = String(formData.get('whatsapp') || '').trim();
          var alamatVal = String(formData.get('alamat') || '').trim();

          if (!/^[a-zA-Z\s]+$/.test(namaVal)) {
            throw new Error('Nama penerima hanya boleh berisi huruf dan spasi.');
          }
          if (!/^[0-9]{9,15}$/.test(waVal)) {
            throw new Error('Nomor WhatsApp hanya boleh berisi angka (9–15 digit).');
          }
          if (!/^[a-zA-Z0-9\s.,\-\/()]+$/.test(alamatVal)) {
            throw new Error('Alamat lengkap tidak boleh mengandung karakter unik atau simbol khusus.');
          }

          var ringkasItem = keranjang.map(function (i) { return { id: i.id, qty: i.qty }; });
          formData.append('items', JSON.stringify(ringkasItem));

          var res = await fetch('/api/checkout', {
            method: 'POST',
            body: formData
          });
          var hasil = await res.json();

          if (!res.ok) {
            throw new Error(hasil.error || 'Checkout gagal diproses.');
          }

          keranjang.forEach(function (item) {
            var sisa = Math.max(0, item.stokMax - item.qty);
            var label = document.getElementById('stok-label-' + item.id);
            var addBtn = document.getElementById('btn-add-' + item.id);

            if (label) {
              label.textContent = sisa <= 0 ? 'Stok habis' : (sisa <= 10 ? 'Stok terbatas · ' + sisa : 'Stok ' + sisa);
              label.className = 'text-xs ' + (sisa <= 10 ? 'text-soga font-medium' : 'text-muted');
            }
            if (addBtn) {
              addBtn.dataset.stok = sisa;
              if (sisa <= 0) {
                addBtn.disabled = true;
                addBtn.textContent = 'Habis';
              }
            }
          });

          keranjang = [];
          localStorage.removeItem('kriya_cart');
          renderKeranjang();
          form.reset();
          form.classList.add('hidden');

          document.getElementById('receipt-code').textContent = hasil.data.kode_pesanan;
          document.getElementById('receipt-total').textContent = formatIdr(hasil.data.total_harga);
          document.getElementById('checkout-success').classList.remove('hidden');
        } catch (err) {
          errBox.textContent = err.message;
          errBox.classList.remove('hidden');
        } finally {
          btn.disabled = false;
          btn.textContent = 'Kirim Pesanan';
        }
      });
    }

    // Form Chatbot AI
    var chatForm = document.getElementById('chat-form');
    if (chatForm) {
      chatForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        var input = document.getElementById('chat-input');
        var sendBtn = document.getElementById('chat-send-btn');
        var quickBox = document.getElementById('chat-quick-prompts');
        var box = document.getElementById('chat-messages');

        var pesan = input.value.trim();
        if (!pesan) return;

        if (quickBox) quickBox.classList.add('hidden');
        tambahGelembungChat('user', pesan);
        input.value = '';
        input.disabled = true;
        sendBtn.disabled = true;

        var typing = document.createElement('div');
        typing.id = 'chat-typing';
        typing.className = 'mr-auto bg-white border border-line text-muted rounded-xl rounded-tl-sm px-3 py-2 text-[11px]';
        typing.textContent = 'Memeriksa katalog...';
        box.appendChild(typing);
        box.scrollTop = box.scrollHeight;

        try {
          var res = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pesan: pesan, riwayat: riwayatChat })
          });
          var data = await res.json();
          typing.remove();

          if (!res.ok) {
            tambahGelembungChat('model', data.error || 'Asisten sedang tidak tersedia.', data.whatsappUrl);
          } else {
            tambahGelembungChat('model', data.balasan);
            riwayatChat.push({ role: 'user', text: pesan });
            riwayatChat.push({ role: 'model', text: data.balasan });
            if (riwayatChat.length > 6) riwayatChat = riwayatChat.slice(-6);
            if (data.whatsappUrl) {
              var waLink = document.getElementById('chat-wa-link');
              if (waLink) waLink.href = data.whatsappUrl;
            }
          }
        } catch (err) {
          typing.remove();
          tambahGelembungChat('model', 'Gagal terhubung ke server. Silakan hubungi pengrajin langsung melalui tombol WhatsApp di bawah.');
        } finally {
          input.disabled = false;
          sendBtn.disabled = false;
          input.focus();
        }
      });
    }
  });
</script>
</body>
</html>