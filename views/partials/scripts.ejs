<script>
  (function () {
    // =========================================================================
    // 1. FILTER KATALOG PRODUK TANPA RELOAD (US-03)
    // =========================================================================
    var tombolFilter = document.querySelectorAll('[data-filter]');
    var kartuProduk = document.querySelectorAll('article[data-kategori]');

    tombolFilter.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var kategoriDipilih = btn.getAttribute('data-filter');

        tombolFilter.forEach(function (b) {
          var aktif = b === btn;
          b.setAttribute('aria-pressed', aktif ? 'true' : 'false');
          b.classList.toggle('border-ink', aktif);
          b.classList.toggle('bg-ink', aktif);
          b.classList.toggle('text-paper', aktif);
          b.classList.toggle('border-line', !aktif);
          b.classList.toggle('hover:border-ink', !aktif);
        });

        kartuProduk.forEach(function (card) {
          var katCard = card.getAttribute('data-kategori');
          var tampil = kategoriDipilih === 'semua' || katCard === kategoriDipilih;
          card.classList.toggle('hidden', !tampil);
        });
      });
    });

    // =========================================================================
    // 2. KERANJANG BELANJA & GUEST CHECKOUT (US-04)
    // =========================================================================
    var STORAGE_CART = 'kriya-keranjang-v1';
    var keranjang = [];

    try {
      var tersimpan = JSON.parse(localStorage.getItem(STORAGE_CART) || '[]');
      if (Array.isArray(tersimpan)) keranjang = tersimpan;
    } catch (e) {
      keranjang = [];
    }

    function simpanKeranjang() {
      try {
        localStorage.setItem(STORAGE_CART, JSON.stringify(keranjang));
      } catch (e) {}
    }

    function formatRp(angka) {
      return 'Rp ' + Number(angka || 0).toLocaleString('id-ID');
    }

    function escHtml(str) {
      return String(str || '').replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function bukaKeranjang() {
      var drawer = document.getElementById('cart-drawer');
      var overlay = document.getElementById('cart-overlay');
      if (overlay) overlay.classList.remove('hidden');
      if (drawer) drawer.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      renderKeranjang();
    }

    function tutupKeranjang() {
      var drawer = document.getElementById('cart-drawer');
      var overlay = document.getElementById('cart-overlay');
      if (overlay) overlay.classList.add('hidden');
      if (drawer) drawer.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }

    function perbaruiBadgeKeranjang() {
      var totalItem = keranjang.reduce(function (sum, item) {
        return sum + Number(item.qty || 0);
      }, 0);

      var badges = document.querySelectorAll('#cart-badge, #cart-count, #jumlah-keranjang, [data-cart-count]');
      badges.forEach(function (el) {
        el.textContent = totalItem;
      });

      var btnNavbar = document.querySelector('button[onclick*="bukaKeranjang"]');
      if (btnNavbar && badges.length === 0) {
        var spanAngka = btnNavbar.querySelector('span:last-child');
        if (spanAngka) spanAngka.textContent = totalItem;
      }
    }

    function renderKeranjang() {
      perbaruiBadgeKeranjang();

      var listEl = document.getElementById('cart-items-container') || document.getElementById('cart-items');
      var totalEl = document.getElementById('cart-total');
      var formEl = document.getElementById('checkout-form');
      var successEl = document.getElementById('checkout-success');
      var errEl = document.getElementById('checkout-error');

      var totalHarga = keranjang.reduce(function (sum, item) {
        return sum + (Number(item.harga) * Number(item.qty));
      }, 0);

      if (totalEl) totalEl.textContent = formatRp(totalHarga);

      if (!listEl) return;

      if (keranjang.length === 0) {
        listEl.innerHTML =
          '<div class="bg-white border border-line rounded-xl p-6 text-center">' +
            '<p class="text-sm text-muted">Keranjang belanja masih kosong.</p>' +
          '</div>';
        if (formEl) formEl.classList.add('hidden');
        return;
      }

      if (successEl) successEl.classList.add('hidden');
      if (errEl) errEl.classList.add('hidden');
      if (formEl) formEl.classList.remove('hidden');

      listEl.innerHTML = keranjang.map(function (item) {
        return (
          '<div class="bg-white border border-line rounded-xl p-3.5 flex items-center justify-between gap-3">' +
            '<div class="min-w-0 flex-1">' +
              '<p class="text-sm font-medium text-ink truncate">' + escHtml(item.nama) + '</p>' +
              '<p class="text-xs text-muted mt-0.5">' + formatRp(item.harga) + ' &times; ' + item.qty + '</p>' +
            '</div>' +
            '<div class="flex items-center gap-1.5 shrink-0">' +
              '<button type="button" onclick="ubahQtyKeranjang(' + item.id + ', -1)" class="w-7 h-7 rounded-md border border-line text-xs hover:border-ink">&minus;</button>' +
              '<span class="w-6 text-center text-xs font-medium tabular-nums">' + item.qty + '</span>' +
              '<button type="button" onclick="ubahQtyKeranjang(' + item.id + ', 1)" class="w-7 h-7 rounded-md border border-line text-xs hover:border-ink">+</button>' +
              '<button type="button" onclick="hapusItemKeranjang(' + item.id + ')" aria-label="Hapus item" class="ml-1 px-1.5 py-1 text-xs text-soga hover:underline">&times;</button>' +
            '</div>' +
          '</div>'
        );
      }).join('');
    }

    function tambahDariTombol(btn) {
      if (!btn) return;
      var id = Number(btn.dataset.id);
      var nama = btn.dataset.nama || 'Produk';
      var harga = Number(btn.dataset.harga || 0);
      var stokMaks = Number(btn.dataset.stok || 0);

      if (stokMaks <= 0) return;

      var ada = keranjang.find(function (item) { return item.id === id; });
      if (ada) {
        if (ada.qty >= stokMaks) {
          alert('Jumlah di keranjang sudah mencapai batas stok tersedia (' + stokMaks + ').');
          bukaKeranjang();
          return;
        }
        ada.qty += 1;
        ada.stok = stokMaks;
      } else {
        keranjang.push({ id: id, nama: nama, harga: harga, qty: 1, stok: stokMaks });
      }

      simpanKeranjang();
      renderKeranjang();

      btn.textContent = 'Ditambahkan ✓';
      setTimeout(function () {
        var stokSekarang = Number(btn.dataset.stok || 0);
        btn.textContent = stokSekarang > 0 ? '+ Keranjang' : 'Habis';
      }, 900);
    }

    function ubahQtyKeranjang(id, delta) {
      var idx = keranjang.findIndex(function (item) { return item.id === Number(id); });
      if (idx === -1) return;

      var baru = keranjang[idx].qty + delta;
      if (baru <= 0) {
        keranjang.splice(idx, 1);
      } else if (keranjang[idx].stok && baru > keranjang[idx].stok) {
        alert('Stok tersedia hanya ' + keranjang[idx].stok + ' unit.');
        return;
      } else {
        keranjang[idx].qty = baru;
      }

      simpanKeranjang();
      renderKeranjang();
    }

    function hapusItemKeranjang(id) {
      keranjang = keranjang.filter(function (item) { return item.id !== Number(id); });
      simpanKeranjang();
      renderKeranjang();
    }

    // Submit form checkout (POST /api/checkout)
    var formCheckout = document.getElementById('checkout-form');
    if (formCheckout) {
      formCheckout.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (keranjang.length === 0) {
          alert('Keranjang belanja masih kosong.');
          return;
        }

        var btnSubmit = document.getElementById('btn-submit-checkout') || formCheckout.querySelector('button[type="submit"]');
        var errBox = document.getElementById('checkout-error');
        var okBox = document.getElementById('checkout-success');
        if (errBox) errBox.classList.add('hidden');
        if (okBox) okBox.classList.add('hidden');

        var teksBtn = btnSubmit ? btnSubmit.textContent : '';
        if (btnSubmit) {
          btnSubmit.disabled = true;
          btnSubmit.textContent = 'Memproses pesanan...';
        }

        try {
          var fd = new FormData(formCheckout);
          fd.set('items', JSON.stringify(keranjang.map(function (i) {
            return { id: i.id, qty: i.qty };
          })));

          var res = await fetch('/api/checkout', {
            method: 'POST',
            body: fd
          });
          var data = await res.json();

          if (!res.ok) {
            throw new Error(data.error || 'Checkout gagal diproses.');
          }

          // Perbarui tampilan stok di kartu produk secara langsung
          keranjang.forEach(function (item) {
            var btnAdd = document.getElementById('btn-add-' + item.id);
            var stokLbl = document.getElementById('stok-label-' + item.id);
            if (btnAdd) {
              var sisa = Math.max(0, Number(btnAdd.dataset.stok || 0) - item.qty);
              btnAdd.dataset.stok = sisa;
              if (sisa <= 0) {
                btnAdd.disabled = true;
                btnAdd.textContent = 'Habis';
              }
              if (stokLbl) {
                if (sisa <= 0) {
                  stokLbl.textContent = 'Stok habis';
                  stokLbl.className = 'text-xs text-soga font-medium';
                } else if (sisa <= 10) {
                  stokLbl.textContent = 'Stok terbatas · ' + sisa;
                  stokLbl.className = 'text-xs text-soga font-medium';
                } else {
                  stokLbl.textContent = 'Stok ' + sisa;
                }
              }
            }
          });

          keranjang = [];
          simpanKeranjang();
          formCheckout.reset();
          renderKeranjang();

          var listEl = document.getElementById('cart-items-container');
          if (listEl) listEl.innerHTML = '';

          var receiptCode = document.getElementById('receipt-code');
          var receiptTotal = document.getElementById('receipt-total');
          if (receiptCode) receiptCode.textContent = (data.data && data.data.kode_pesanan) || '-';
          if (receiptTotal) receiptTotal.textContent = formatRp(data.data && data.data.total_harga);
          if (okBox) okBox.classList.remove('hidden');
        } catch (err) {
          if (errBox) {
            errBox.textContent = err.message;
            errBox.classList.remove('hidden');
          } else {
            alert(err.message);
          }
        } finally {
          if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.textContent = teksBtn || 'Kirim Pesanan';
          }
        }
      });
    }

    // =========================================================================
    // 3. CHATBOT ASISTEN BELANJA AI + PERSISTENSI LOCALSTORAGE (US-02 / F-02)
    // =========================================================================
    var STORAGE_CHAT = 'kriya-chat-history-v1';
    var riwayatChat = [];

    try {
      var chatTersimpan = JSON.parse(localStorage.getItem(STORAGE_CHAT) || '[]');
      if (Array.isArray(chatTersimpan)) riwayatChat = chatTersimpan;
    } catch (e) {
      riwayatChat = [];
    }

    function simpanRiwayatChat() {
      try {
        localStorage.setItem(STORAGE_CHAT, JSON.stringify(riwayatChat.slice(-20)));
      } catch (e) {}
    }

    function cariPanelChat() {
      return document.getElementById('chat-panel') ||
             document.getElementById('chat-window') ||
             document.getElementById('chat-box') ||
             document.getElementById('widget-chat-panel');
    }

    function cariKontainerPesan() {
      return document.getElementById('chat-messages') ||
             document.getElementById('chat-list') ||
             document.getElementById('pesan-chat') ||
             document.getElementById('isi-chat');
    }

    function renderRiwayatChat() {
      var box = cariKontainerPesan();
      if (!box) return;

      var sapaanAwal =
        '<div class="bg-paper border border-line rounded-xl px-3.5 py-2.5 text-xs text-ink leading-relaxed">' +
          'Halo! Saya Asisten Belanja Kriya. Tanyakan rekomendasi motif batik/tenun, harga, atau ketersediaan stok.' +
        '</div>';

      if (riwayatChat.length === 0) {
        box.innerHTML = sapaanAwal;
        return;
      }

      box.innerHTML = sapaanAwal + riwayatChat.map(function (msg) {
        if (msg.role === 'user') {
          return (
            '<div class="flex justify-end">' +
              '<div class="max-w-[85%] rounded-xl bg-ink text-paper px-3.5 py-2 text-xs leading-relaxed">' +
                escHtml(msg.text) +
              '</div>' +
            '</div>'
          );
        }

        return (
          '<div class="flex justify-start">' +
            '<div class="max-w-[88%] rounded-xl bg-paper border border-line text-ink px-3.5 py-2.5 text-xs leading-relaxed whitespace-pre-line">' +
              escHtml(msg.text) +
            '</div>' +
          '</div>'
        );
      }).join('');

      box.scrollTop = box.scrollHeight;
    }

    function toggleChatWidget() {
      var panel = cariPanelChat();
      if (!panel) return;
      var akanBuka = panel.classList.contains('hidden');
      panel.classList.toggle('hidden');
      if (akanBuka) {
        renderRiwayatChat();
        var input = document.getElementById('chat-input') || document.getElementById('input-chat') || panel.querySelector('input[type="text"], textarea');
        if (input) input.focus();
      }
    }

    function bukaChatWidget() {
      var panel = cariPanelChat();
      if (!panel) return;
      panel.classList.remove('hidden');
      renderRiwayatChat();
    }

    function tutupChatWidget() {
      var panel = cariPanelChat();
      if (!panel) return;
      panel.classList.add('hidden');
    }

    function hapusRiwayatChat() {
      riwayatChat = [];
      simpanRiwayatChat();
      renderRiwayatChat();
    }

    async function prosesKirimChat(teksPesan) {
      var pesan = String(teksPesan || '').trim();
      if (!pesan) return;

      riwayatChat.push({ role: 'user', text: pesan });
      simpanRiwayatChat();
      renderRiwayatChat();

      var box = cariKontainerPesan();
      var loadingId = 'chat-loading-' + Date.now();
      if (box) {
        box.insertAdjacentHTML('beforeend',
          '<div id="' + loadingId + '" class="text-xs text-muted italic px-1">Asisten Kriya sedang mengetik...</div>'
        );
        box.scrollTop = box.scrollHeight;
      }

      try {
        var res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            pesan: pesan,
            riwayat: riwayatChat.slice(-6)
          })
        });
        var data = await res.json();

        var loadingEl = document.getElementById(loadingId);
        if (loadingEl) loadingEl.remove();

        if (!res.ok) {
          riwayatChat.push({
            role: 'assistant',
            text: data.error || 'Sistem sedang sibuk, silakan coba beberapa saat lagi.'
          });
        } else {
          riwayatChat.push({
            role: 'assistant',
            text: data.balasan || 'Maaf, belum ada jawaban.'
          });
        }
      } catch (err) {
        var loadingElErr = document.getElementById(loadingId);
        if (loadingElErr) loadingElErr.remove();

        riwayatChat.push({
          role: 'assistant',
          text: 'Koneksi terganggu. Silakan coba lagi beberapa saat lagi.'
        });
      }

      simpanRiwayatChat();
      renderRiwayatChat();
    }

    function kirimPesanChat(e) {
      if (e && e.preventDefault) e.preventDefault();
      var panel = cariPanelChat() || document;
      var input = document.getElementById('chat-input') ||
                  document.getElementById('input-chat') ||
                  panel.querySelector('input[type="text"], textarea');
      if (!input) return;
      var teks = input.value.trim();
      if (!teks) return;
      input.value = '';
      prosesKirimChat(teks);
    }

    var formChat = document.getElementById('chat-form') || document.getElementById('form-chat');
    if (formChat) {
      formChat.addEventListener('submit', kirimPesanChat);
    }

    // Sinkronisasi jika stok diubah admin di tab lain
    window.addEventListener('storage', function (e) {
      if (e.key === 'kriya-produk-berubah') {
        window.location.reload();
      }
    });

    // Ekspos fungsi global untuk atribut onclick/onsubmit di EJS
    window.tambahDariTombol = tambahDariTombol;
    window.bukaKeranjang = bukaKeranjang;
    window.tutupKeranjang = tutupKeranjang;
    window.ubahQtyKeranjang = ubahQtyKeranjang;
    window.hapusItemKeranjang = hapusItemKeranjang;
    window.toggleChatWidget = toggleChatWidget;
    window.bukaChatWidget = bukaChatWidget;
    window.tutupChatWidget = tutupChatWidget;
    window.hapusRiwayatChat = hapusRiwayatChat;
    window.kirimPesanChat = kirimPesanChat;
    window.kirimChat = kirimPesanChat;

    // Inisialisasi tampilan awal
    renderKeranjang();
    renderRiwayatChat();
  })();
</script>
</body>
</html>