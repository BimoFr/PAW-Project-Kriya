<div id="cart-overlay" onclick="tutupKeranjang()" class="hidden fixed inset-0 z-50 bg-ink/40 backdrop-blur-[1px]"></div>

<aside id="cart-drawer" aria-label="Keranjang Belanja"
       class="hidden fixed top-0 right-0 z-50 h-full w-full max-w-md bg-paper border-l border-line flex flex-col">
  <div class="px-6 py-5 border-b border-line flex items-center justify-between">
    <div>
      <p class="text-xs font-medium uppercase tracking-wider text-soga">Ringkasan Belanja</p>
      <h2 class="font-display font-semibold text-xl">Keranjang</h2>
    </div>
    <button type="button" onclick="tutupKeranjang()" class="p-2 text-muted hover:text-ink" aria-label="Tutup keranjang">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <div class="flex-1 overflow-y-auto px-6 py-5 space-y-6">
    <!-- Daftar Item Keranjang -->
    <div id="cart-items-container" class="space-y-3"></div>

    <!-- Form Guest Checkout -->
    <form id="checkout-form" class="hidden pt-5 border-t border-line space-y-4">
      <div>
        <p class="text-xs font-medium uppercase tracking-wider text-soga">Data Pengiriman &amp; Pembayaran</p>
        <p class="text-xs text-muted mt-1">Transfer ke <strong class="text-ink">BCA 1234567890 a.n. Kriya Nusantara</strong> sesuai total tagihan, lalu unggah bukti transfer.</p>
      </div>

      <div>
        <label class="block text-xs font-medium uppercase tracking-wider text-muted mb-1">Nama Penerima</label>
        <input type="text" name="nama_pembeli" required placeholder="Nama lengkap"
               oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')"
               class="w-full px-3.5 py-2 text-sm bg-white border border-line rounded-lg focus:outline-none focus:border-ink">
      </div>

      <div>
        <label class="block text-xs font-medium uppercase tracking-wider text-muted mb-1">Nomor WhatsApp</label>
        <input type="tel" name="whatsapp" inputmode="numeric" maxlength="15" required placeholder="0812xxxxxxxx"
               oninput="this.value = this.value.replace(/[^0-9]/g, '')"
               class="w-full px-3.5 py-2 text-sm bg-white border border-line rounded-lg focus:outline-none focus:border-ink">
      </div>

      <div>
        <label class="block text-xs font-medium uppercase tracking-wider text-muted mb-1">Alamat Lengkap</label>
        <textarea name="alamat" rows="2" required placeholder="Jl. Contoh No. 12, Kel. Gondokusuman, Yogyakarta"
                  oninput="this.value = this.value.replace(/[^a-zA-Z0-9\s.,\-\/()]/g, '')"
                  class="w-full px-3.5 py-2 text-sm bg-white border border-line rounded-lg focus:outline-none focus:border-ink"></textarea>
      </div>

      <div>
        <label class="block text-xs font-medium uppercase tracking-wider text-muted mb-1">Bukti Transfer (JPG/PNG)</label>
        <input type="file" name="bukti_transfer" accept="image/*" required
               class="w-full text-xs text-muted file:mr-3 file:py-2 file:px-3 file:rounded-md file:border file:border-line file:bg-white file:text-ink file:font-medium hover:file:border-ink">
      </div>

      <p id="checkout-error" class="hidden text-xs text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2"></p>

      <div class="pt-2">
        <div class="flex items-center justify-between text-sm font-medium mb-3">
          <span class="text-muted">Total Pembayaran</span>
          <span id="cart-total" class="font-display text-lg tabular-nums">Rp 0</span>
        </div>
        <button type="submit" id="btn-submit-checkout"
                class="w-full bg-ink text-paper text-sm font-medium py-3 rounded-lg hover:bg-soga transition-colors">
          Kirim Pesanan
        </button>
      </div>
    </form>

    <!-- Notifikasi Sukses Setelah Checkout -->
    <div id="checkout-success" class="hidden bg-white border border-line rounded-xl p-5 space-y-3">
      <p class="text-xs font-medium uppercase tracking-wider text-soga">Pesanan Tercatat</p>
      <h3 class="font-display font-semibold text-lg">Terima kasih atas pesananmu</h3>

      <div class="flex items-center justify-between gap-2 bg-paper border border-line rounded-lg px-3 py-2">
        <span class="text-xs text-muted">Kode: <strong id="receipt-code" class="font-mono text-ink"></strong></span>
        <button type="button" id="btn-copy-code" onclick="salinKodePesanan()"
                class="text-[11px] font-medium text-soga hover:underline">
          Salin
        </button>
      </div>

      <p class="text-xs text-muted leading-relaxed">
        Total transfer: <strong id="receipt-total" class="text-ink"></strong><br>
        Stok katalog telah diperbarui otomatis. Pengelola akan segera memverifikasi bukti transfermu.
      </p>

      <div class="pt-1 flex flex-col gap-2">
        <a id="btn-lacak-receipt" href="/lacak"
           class="w-full py-2.5 text-xs font-medium text-center bg-ink text-paper rounded-lg hover:bg-soga transition-colors">
          Lacak Progres Pesanan
        </a>
        <button type="button" onclick="tutupKeranjang()"
                class="w-full py-2.5 text-xs font-medium border border-line text-ink rounded-lg hover:border-ink transition-colors">
          Selesai
        </button>
      </div>
    </div>
  </div>
</aside>