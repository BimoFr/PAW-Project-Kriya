<%- include('partials/head', { title }) %>
<%- include('partials/navbar') %>

<main id="konten" class="flex-1">
  <section class="max-w-6xl mx-auto px-5 sm:px-8 py-14 sm:py-16">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6">
      <div>
        <h1 class="font-display font-semibold tracking-tight text-3xl sm:text-4xl">Kelola produk</h1>
        <p class="mt-2 text-muted max-w-xl">Tambah, ubah, dan hapus produk. Setiap perubahan langsung tersimpan di database.</p>
      </div>
      <button id="btn-tambah" type="button" class="self-start sm:self-auto bg-ink text-paper text-sm font-medium px-6 py-3.5 rounded-lg transition-colors duration-200 hover:bg-soga">Tambah produk</button>
    </div>

    <div id="daftar" class="mt-10 border-t border-line" aria-live="polite">
      <p class="py-12 text-muted">Memuat data…</p>
    </div>
  </section>
</main>

<!-- Form tambah / ubah -->
<dialog id="dlg-form" class="m-auto w-[min(92vw,34rem)] max-h-[92vh] overflow-y-auto rounded-2xl bg-paper text-ink border border-line p-0">
  <form id="form" novalidate class="p-6 sm:p-8">
    <h2 id="form-judul" class="font-display font-semibold text-2xl tracking-tight">Tambah produk</h2>

    <div class="mt-6 grid gap-4">
      <div>
        <label for="f-nama" class="lbl">Nama produk</label>
        <input id="f-nama" name="nama" type="text" maxlength="120" required class="input" placeholder="Contoh: Batik Tulis Parang 2 m">
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="f-kategori" class="lbl">Kategori</label>
          <select id="f-kategori" name="kategori" class="input">
            <% kategori.forEach(function (k) { %><option value="<%= k %>"><%= k %></option><% }) %>
          </select>
        </div>
        <div>
          <label for="f-motif" class="lbl">Motif</label>
          <select id="f-motif" name="motif" class="input">
            <% motif.forEach(function (m) { %><option value="<%= m %>"><%= m.charAt(0).toUpperCase() + m.slice(1) %></option><% }) %>
          </select>
        </div>
        <div>
          <label for="f-harga" class="lbl">Harga (Rp)</label>
          <input id="f-harga" name="harga" type="number" min="0" step="1000" required class="input" placeholder="185000">
        </div>
        <div>
          <label for="f-stok" class="lbl">Stok</label>
          <input id="f-stok" name="stok" type="number" min="0" step="1" required class="input" placeholder="10">
        </div>
      </div>
      <div>
        <label for="f-deskripsi" class="lbl">Deskripsi</label>
        <textarea id="f-deskripsi" name="deskripsi" rows="3" maxlength="500" class="input" placeholder="Bahan, teknik, dan kegunaan"></textarea>
      </div>
    </div>

    <ul id="form-error" class="mt-4 text-sm text-soga list-disc pl-5 hidden" role="alert"></ul>

    <div class="mt-8 flex justify-end gap-3">
      <button type="button" id="btn-batal" class="px-5 py-3 rounded-lg border border-line text-sm font-medium transition-colors hover:border-ink">Batal</button>
      <button type="submit" id="btn-simpan" class="px-6 py-3 rounded-lg bg-ink text-paper text-sm font-medium transition-colors hover:bg-soga disabled:opacity-60">Simpan</button>
    </div>
  </form>
</dialog>

<!-- Konfirmasi hapus -->
<dialog id="dlg-hapus" class="m-auto w-[min(92vw,26rem)] rounded-2xl bg-paper text-ink border border-line p-0">
  <div class="p-6 sm:p-8">
    <h2 class="font-display font-semibold text-xl tracking-tight">Hapus produk?</h2>
    <p class="mt-3 text-sm text-muted"><span id="hapus-nama" class="font-medium text-ink"></span> akan dihapus permanen dari database.</p>
    <div class="mt-8 flex justify-end gap-3">
      <button type="button" id="hapus-batal" class="px-5 py-3 rounded-lg border border-line text-sm font-medium transition-colors hover:border-ink">Batal</button>
      <button type="button" id="hapus-ok" class="px-6 py-3 rounded-lg bg-soga text-white text-sm font-medium transition-colors hover:bg-soga-dark">Hapus</button>
    </div>
  </div>
</dialog>

<div id="toast" role="status" aria-live="polite" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 hidden bg-ink text-paper text-sm px-5 py-3 rounded-lg"></div>

<%- include('partials/footer') %>
<script>
  window.KRIYA = { kategori: <%- JSON.stringify(kategori) %> };
</script>
<%- include('partials/scripts-kelola') %>
<%- include('partials/scripts') %>
