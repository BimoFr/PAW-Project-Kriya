<%
  const listProduk = typeof produk !== 'undefined' ? produk : (typeof daftarProduk !== 'undefined' ? daftarProduk : []);
  const listPesanan = typeof pesanan !== 'undefined' ? pesanan : (typeof daftarPesanan !== 'undefined' ? daftarPesanan : []);
  const totalStok = listProduk.reduce((acc, p) => acc + Number(p.stok || 0), 0);
  const pesananMenunggu = listPesanan.filter((o) => o.status === 'Menunggu Verifikasi').length;
  const statusTerbayar = ['Proses Kirim', 'Pesanan Selesai', 'Diproses', 'Dikirim'];
  const pesananTerbayar = listPesanan.filter((o) => statusTerbayar.includes(o.status));
  const totalPendapatan = pesananTerbayar.reduce((acc, o) => acc + Number(o.total_harga || 0), 0);
%>
<%- include('partials/head', { title: 'Kelola Toko — ' + appName }) %>
<%- include('partials/navbar', { active: 'kelola', isAdmin: true }) %>

<main class="max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-10">
  <!-- Header Halaman Admin -->
  <section class="border-b border-line pb-6">
    <p class="text-xs font-medium uppercase tracking-widest text-soga">Panel Pengrajin</p>
    <h1 class="font-display text-2xl sm:text-3xl font-semibold text-ink mt-1">Kelola Produk &amp; Pesanan</h1>
    <p class="text-sm text-muted mt-1">Atur katalog kain, buat deskripsi otomatis dengan AI, dan perbarui status transaksi.</p>
  </section>

  <!-- Ringkasan Singkat & Laporan Penjualan (F-05) -->
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white border border-line rounded-xl p-4">
      <p class="text-xs text-muted">Total Jenis Kain</p>
      <p class="font-display text-2xl font-semibold text-ink mt-1 tabular-nums"><%= listProduk.length %></p>
    </div>
    <div class="bg-white border border-line rounded-xl p-4">
      <p class="text-xs text-muted">Total Stok Tersedia</p>
      <p class="font-display text-2xl font-semibold text-ink mt-1 tabular-nums"><%= totalStok %> kain</p>
    </div>
    <div class="bg-white border border-line rounded-xl p-4">
      <p class="text-xs text-muted">Menunggu Verifikasi</p>
      <p class="font-display text-2xl font-semibold text-soga mt-1 tabular-nums"><%= pesananMenunggu %> pesanan</p>
    </div>
    <div class="bg-white border border-line rounded-xl p-4">
      <div class="flex items-center justify-between gap-2">
        <p class="text-xs text-muted">Total Pendapatan</p>
        <span class="text-[11px] font-medium text-muted"><%= pesananTerbayar.length %> transaksi</span>
      </div>
      <p class="font-display text-2xl font-semibold text-ink mt-1 tabular-nums">Rp <%= totalPendapatan.toLocaleString('id-ID') %></p>
    </div>
  </section>

  <!-- Manajemen Katalog Produk (US-01 & US-06) -->
  <section class="bg-white border border-line rounded-2xl p-5 sm:p-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-line">
      <div>
        <h2 class="font-display text-lg font-semibold text-ink">Daftar Produk Katalog</h2>
        <p class="text-xs text-muted mt-0.5">Tambahkan kain baru atau perbarui stok serta deskripsi produk yang sudah ada.</p>
      </div>
      <button type="button" id="btn-tambah"
              class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-ink text-paper text-xs font-medium hover:bg-soga transition-colors shrink-0">
        <span>+ Tambah produk</span>
      </button>
    </div>

    <!-- Container Daftar Produk (dirender oleh scripts-kelola.ejs) -->
    <div id="daftar" class="divide-y divide-line">
      <p class="py-10 text-sm text-muted">Memuat daftar produk...</p>
    </div>
  </section>

  <!-- Manajemen Pesanan Masuk (US-05) -->
  <section class="bg-white border border-line rounded-2xl overflow-hidden">
    <div class="px-5 py-4 border-b border-line flex items-center justify-between">
      <div>
        <h2 class="font-display text-lg font-semibold text-ink">Transaksi &amp; Pesanan Masuk</h2>
        <p class="text-xs text-muted mt-0.5">Verifikasi bukti transfer pelanggan dan perbarui progres pengiriman.</p>
      </div>
      <span class="text-xs text-muted"><%= listPesanan.length %> pesanan</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-line bg-paper/60 text-muted uppercase tracking-wider text-[11px]">
            <th class="py-3 px-4">Kode</th>
            <th class="py-3 px-4">Pembeli</th>
            <th class="py-3 px-4">Item Pesanan</th>
            <th class="py-3 px-4">Total &amp; Bukti</th>
            <th class="py-3 px-4">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% if (listPesanan.length === 0) { %>
            <tr>
              <td colspan="5" class="py-8 px-4 text-center text-muted">Belum ada transaksi masuk.</td>
            </tr>
          <% } %>
          <% listPesanan.forEach((o) => {
            let items = [];
            try { items = JSON.parse(o.daftar_item || '[]'); } catch {}
          %>
            <tr class="hover:bg-paper/40 transition-colors align-top">
              <td class="py-3.5 px-4 font-mono font-medium text-ink whitespace-nowrap"><%= o.kode_pesanan %></td>
              <td class="py-3.5 px-4">
                <p class="font-medium text-ink"><%= o.nama_pembeli %></p>
                <a href="https://wa.me/<%= o.whatsapp %>" target="_blank" rel="noopener noreferrer" class="text-soga hover:underline">
                  <%= o.whatsapp %>
                </a>
                <p class="text-muted mt-0.5 max-w-xs"><%= o.alamat %></p>
              </td>
              <td class="py-3.5 px-4">
                <ul class="space-y-0.5">
                  <% items.forEach((it) => { %>
                    <li><%= it.nama %> &times; <%= it.qty %></li>
                  <% }) %>
                </ul>
              </td>
              <td class="py-3.5 px-4 whitespace-nowrap">
                <p class="font-medium text-ink tabular-nums">Rp <%= Number(o.total_harga).toLocaleString('id-ID') %></p>
                <% if (o.bukti_transfer) { %>
                  <a href="<%= o.bukti_transfer %>" target="_blank" rel="noopener noreferrer" class="inline-block mt-1 text-soga underline">
                    Lihat Bukti &rarr;
                  </a>
                <% } %>
              </td>
              <td class="py-3.5 px-4 whitespace-nowrap">
                <div class="inline-flex items-center gap-1.5">
                  <select id="status-ord-<%= o.id %>"
                          class="px-2.5 py-1.5 rounded-lg border border-line bg-paper/60 text-xs font-medium text-ink focus:outline-none focus:border-ink">
                    <option value="Menunggu Verifikasi" <%= o.status === 'Menunggu Verifikasi' ? 'selected' : '' %>>Menunggu Verifikasi</option>
                    <option value="Dikirim" <%= (o.status === 'Dikirim' || o.status === 'Proses Kirim' || o.status === 'Diproses') ? 'selected' : '' %>>Dikirim</option>
                    <option value="Pesanan Selesai" <%= o.status === 'Pesanan Selesai' ? 'selected' : '' %>>Pesanan Selesai</option>
                  </select>
                  <button type="button" data-id="<%= o.id %>" onclick="simpanStatusPesanan(this.dataset.id)"
                          class="px-2.5 py-1.5 rounded-lg bg-ink text-paper text-xs font-medium hover:bg-soga transition-colors">
                    Simpan
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>

<!-- Dialog Tambah / Ubah Produk + AI Auto-Caption (US-01 & US-06) -->
<dialog id="dlg-form" class="w-full max-w-lg rounded-2xl border border-line bg-paper p-0 text-ink shadow-xl backdrop:bg-ink/50">
  <form id="form" class="p-6 space-y-4">
    <div class="flex items-center justify-between border-b border-line pb-3">
      <h2 id="form-judul" class="font-display text-lg font-semibold text-ink">Tambah produk</h2>
      <button type="button" id="btn-batal" aria-label="Tutup dialog"
              class="px-2.5 py-1 rounded-lg text-sm text-muted hover:text-ink">
        &times;
      </button>
    </div>

    <ul id="form-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-3.5 py-2.5 text-xs text-red-700 list-disc list-inside space-y-0.5"></ul>

    <div>
      <label class="block text-xs font-medium text-ink mb-1">Nama Produk</label>
      <input type="text" name="nama" required placeholder="Contoh: Batik Tulis Parang Rusak Soga"
             class="w-full px-3 py-2 text-sm bg-white border border-line rounded-lg focus:outline-none focus:border-ink">
    </div>

    <div>
      <label class="block text-xs font-medium text-ink mb-1">Kategori</label>
      <select name="kategori"
              class="w-full px-3 py-2 text-sm bg-white border border-line rounded-lg focus:outline-none focus:border-ink">
        <option value="Batik">Batik</option>
        <option value="Tenun">Tenun</option>
      </select>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-xs font-medium text-ink mb-1">Harga (Rp)</label>
        <input type="number" name="harga" min="1000" step="500" required placeholder="250000"
               class="w-full px-3 py-2 text-sm bg-white border border-line rounded-lg focus:outline-none focus:border-ink">
      </div>

      <div>
        <label class="block text-xs font-medium text-ink mb-1">Stok</label>
        <input type="number" name="stok" min="0" required placeholder="10"
               class="w-full px-3 py-2 text-sm bg-white border border-line rounded-lg focus:outline-none focus:border-ink">
      </div>
    </div>

    <div>
      <div class="flex items-center justify-between gap-2 mb-1">
        <label class="block text-xs font-medium text-ink">Deskripsi Produk</label>
        <button type="button" id="btn-generate-caption"
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg border border-soga/40 bg-soga/10 text-soga text-xs font-medium hover:bg-soga hover:text-paper transition-colors">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1m0-12.8-2.1 2.1M7.7 16.3l-2.1 2.1"/>
          </svg>
          <span>Generate Caption AI</span>
        </button>
      </div>
      <textarea name="deskripsi" rows="3" required
                placeholder="Isi nama produk lalu klik 'Generate Caption AI' untuk membuat deskripsi otomatis..."
                class="w-full px-3 py-2 text-sm bg-white border border-line rounded-lg focus:outline-none focus:border-ink"></textarea>
    </div>

    <div>
      <label class="block text-xs font-medium text-ink mb-1.5">Foto Produk (Wajib, maks. 2 MB)</label>
      <input type="hidden" name="gambar">
      <div class="flex items-center gap-3">
        <div id="pratinjau" class="w-16 h-16 rounded-lg border border-line bg-white flex items-center justify-center text-[11px] text-muted overflow-hidden shrink-0">
          Belum ada
        </div>
        <div class="space-y-1.5 flex-1">
          <input type="file" id="f-berkas" accept="image/jpeg,image/png,image/webp"
                 class="w-full text-xs text-muted file:mr-2.5 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-medium file:bg-ink file:text-paper hover:file:bg-soga">
          <button type="button" id="btn-hapus-gambar" class="hidden text-xs text-soga hover:underline">
            Hapus gambar
          </button>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-end gap-2 pt-2 border-t border-line">
      <button type="button" onclick="document.getElementById('dlg-form').close()"
              class="px-4 py-2 rounded-lg border border-line bg-white text-xs font-medium text-ink hover:border-ink">
        Batal
      </button>
      <button type="submit" id="btn-simpan"
              class="px-5 py-2 rounded-lg bg-ink text-paper text-xs font-medium hover:bg-soga transition-colors">
        Simpan
      </button>
    </div>
  </form>
</dialog>

<!-- Dialog Konfirmasi Hapus Produk -->
<dialog id="dlg-hapus" class="w-full max-w-sm rounded-2xl border border-line bg-paper p-6 text-ink shadow-xl backdrop:bg-ink/50">
  <h2 class="font-display text-lg font-semibold text-ink">Hapus Produk?</h2>
  <p class="text-xs text-muted mt-1.5 leading-relaxed">
    Produk <strong id="hapus-nama" class="text-ink"></strong> akan dihapus permanen dari katalog.
  </p>
  <div class="flex items-center justify-end gap-2 mt-5">
    <button type="button" id="hapus-batal"
            class="px-3.5 py-2 rounded-lg border border-line bg-white text-xs font-medium text-ink hover:border-ink">
      Batal
    </button>
    <button type="button" id="hapus-ok"
            class="px-3.5 py-2 rounded-lg bg-soga text-paper text-xs font-medium hover:opacity-90">
      Hapus
    </button>
  </div>
</dialog>

<!-- Toast Notifikasi -->
<div id="toast" role="status" aria-live="polite"
     class="hidden fixed bottom-5 right-5 z-50 px-4 py-2.5 rounded-xl bg-ink text-paper text-xs font-medium shadow-lg">
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var formProduk = document.getElementById('form');
    var errList = document.getElementById('form-error');
    var inputBerkas = document.getElementById('f-berkas');
    if (!formProduk) return;

    formProduk.addEventListener('submit', function (e) {
      var nilaiGambar = (formProduk.elements.gambar && formProduk.elements.gambar.value || '').trim();
      var adaFileBaru = inputBerkas && inputBerkas.files && inputBerkas.files.length > 0;

      if (!nilaiGambar && !adaFileBaru) {
        e.preventDefault();
        e.stopImmediatePropagation();
        if (errList) {
          errList.innerHTML = '<li>Foto produk wajib dipilih terlebih dahulu.</li>';
          errList.classList.remove('hidden');
        }
        if (inputBerkas) inputBerkas.focus();
      }
    }, true);
  });
</script>

<%- include('partials/footer') %>
<%- include('partials/scripts-kelola') %>